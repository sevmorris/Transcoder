# Pinned FFmpeg binaries for Transcoder (arm64 macOS).
# Audio-only LGPL build — no --enable-gpl, no --enable-nonfree, no
# --enable-version3. libmp3lame and libopus are the only external libraries;
# aac, alac, flac and pcm_* are FFmpeg's own.
#
# Built by scripts/build-ffmpeg.sh: FilmStrip's recipe r5 plus a static
# libopus. REPRODUCIBLE: two runs on 2026-11-10 (Xcode 27.2) produced the
# checksums below byte for byte.
#
# Superseded pins must NOT be deleted — each is what older commits verify against:
#   ffmpeg-deps-9.0.2-audio-arm64-r5   sevmorris/FilmStrip   borrowed, before this repo hosted its own

# The deps release MUST stay flagged as a prerelease: an ordinary release
# becomes /releases/latest and breaks the README download link.
FFMPEG_VERSION=9.0.2
FFMPEG_ARCH=arm64
FFMPEG_DEPS_REPO=sevmorris/Transcoder
FFMPEG_DEPS_TAG=ffmpeg-deps-9.0.2-audio-opus-arm64-r5
FFMPEG_SHA256=27c4b4eda9d31f3944dac8e6e35b4b0f7703e5759c444922083a3ea3ceb4dbb6
FFPROBE_SHA256=9c637ade34f5d1ebcd1439bf953501f55476429bacfa8f408c9eb3958968db97

# Corresponding upstream source (LGPL §6) — see Vendor/README.md
FFMPEG_SOURCE_RELEASE=9.0.2
FFMPEG_SOURCE_RELEASE_DATE=2026-09-17
FFMPEG_SOURCE_ARCHIVE=ffmpeg-9.0.2.tar.xz
FFMPEG_SOURCE_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SOURCE_SIGNATURE_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc
FFMPEG_SOURCE_GIT_TAG=n9.0.2

# Statically linked dependencies
LAME_VERSION=4.0
LAME_SOURCE_URL=https://downloads.sourceforge.net/project/lame/lame/4.0/lame-4.0.tar.gz
OPUS_VERSION=1.6.1
OPUS_SOURCE_URL=https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz
