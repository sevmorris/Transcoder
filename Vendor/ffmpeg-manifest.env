# Pinned FFmpeg binaries for Transcoder (arm64 macOS).
# Audio-only LGPL build produced by FilmStrip's scripts/build-ffmpeg.sh (recipe
# r5) — no --enable-gpl, no --enable-nonfree, no --enable-version3; libmp3lame
# is the only external library. Every other encoder Transcoder uses (aac, alac,
# flac, pcm_*, opus, vorbis) is FFmpeg's own.
#
# BORROWED PIN: until Transcoder has a GitHub repository of its own to host a
# deps release, this points at FilmStrip's r5 assets, byte for byte the build
# FilmStrip ships. Before the first release, build and host Transcoder's own
# (each FFmpeg repo hosts its own; see ~/Projects/CLAUDE.md) and record this
# pin below as superseded rather than deleting it.
#
# The deps release MUST stay flagged as a prerelease: an ordinary release
# becomes /releases/latest and breaks the README download link.
FFMPEG_VERSION=9.0.2
FFMPEG_ARCH=arm64
FFMPEG_DEPS_REPO=sevmorris/FilmStrip
FFMPEG_DEPS_TAG=ffmpeg-deps-9.0.2-audio-arm64-r5
FFMPEG_SHA256=e12f16a3aeeb88facb7792ebe513fe31b6094f2da49d984b8ed1feae5f8971d0
FFPROBE_SHA256=0a36d98fbe6ebcc7614fdcdc07144e89475feb512dfe985c7dc7f9ac11336ae3

# Corresponding upstream source (LGPL §6) — see Vendor/README.md
FFMPEG_SOURCE_RELEASE=9.0.2
FFMPEG_SOURCE_RELEASE_DATE=2026-09-17
FFMPEG_SOURCE_ARCHIVE=ffmpeg-9.0.2.tar.xz
FFMPEG_SOURCE_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SOURCE_SIGNATURE_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc
FFMPEG_SOURCE_GIT_TAG=n9.0.2

# Statically linked LGPL dependency
LAME_VERSION=4.0
LAME_SOURCE_URL=https://downloads.sourceforge.net/project/lame/lame/4.0/lame-4.0.tar.gz
